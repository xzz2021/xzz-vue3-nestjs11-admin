{
  "name": "xzz-vue3-nestjs11-admin",
  "version": "1.0.0",
  "author": "xzz2021",
  "description": "vue3 nestjs11 prisma8 vite8 ",
  "keywords": [],
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm --filter server build && pnpm --filter web build",
    "lint": "pnpm --filter server lint:check && pnpm --filter web lint:check",
    "lint:eslint": "pnpm --filter server lint:eslint && pnpm --filter web lint:eslint",
    "typecheck": "pnpm --filter server typecheck:all && pnpm --filter web typecheck",
    "test": "pnpm --filter server test:ci",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "preflight:server": "pnpm --filter server preflight",
    "lint-staged": "lint-staged --config .husky/lintstagedrc.cjs",
    "prepare": "node -e \"if (process.env.HUSKY === '0' || !require('fs').existsSync('.git')) process.exit(0); require('child_process').execSync('husky', { stdio: 'inherit' })\"",
    "env:generate": "node scripts/generate-production-env.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@11.13.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
