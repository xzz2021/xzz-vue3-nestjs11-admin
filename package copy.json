{
  "name": "admin2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "dev:server": "pnpm --filter server dev",
    "dev": "pnpm --filter \"./apps/*\" --parallel dev",
    "build": "pnpm --filter server build && pnpm --filter admin build",
    "lint": "pnpm --filter server lint:check && pnpm --filter admin lint:check",
    "lint:eslint": "pnpm --filter server lint:eslint && pnpm --filter admin lint:eslint",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter admin typecheck",
    "test": "pnpm --filter server test:ci",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint-staged": "lint-staged --config .husky/lintstagedrc.cjs",
    "prepare": "node -e \"if (process.env.HUSKY === '0' || !require('fs').existsSync('.git')) process.exit(0); require('child_process').execSync('husky', { stdio: 'inherit' })\"",
    "env:generate": "node scripts/generate-production-env.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.13.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2"
  }
}
