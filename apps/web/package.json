{
  "name": "web",
  "version": "1.0.0",
  "description": "一套基于vue3、element-plus、typesScript、vite4的后台集成方案。",
  "type": "module",
  "scripts": {
    "preview": "vite preview",
    "dev": "concurrently -k -n tsc,vite -c cyan,green \"vue-tsc -b --watch --preserveWatchOutput\" \"vite --mode base\"",
    "ts:check": "vue-tsc --noEmit --skipLibCheck",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "build": "run build:pro",
    "build:pro": "vue-tsc -b && vite build --mode pro",
    "build:gitee": "vite build --mode gitee",
    "build:dev": "vite build --mode dev",
    "build:test": "vite build --mode test",
    "serve:pro": "vite preview --mode pro",
    "serve:dev": "vite preview --mode dev",
    "serve:test": "vite preview --mode test",
    "npm:check": "pnpx npm-check-updates -u",
    "lint:check": "eslint . \"src/**/*.{js,ts,tsx,vue,html}\"",
    "lint:eslint": "eslint . --fix \"src/**/*.{js,ts,tsx,vue,html}\"",
    "lint:format": "prettier --write --log-level warn \"src/**/*.{js,ts,json,tsx,css,less,vue,html,md}\"",
    "lint:style": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@noble/hashes": "^2.4.0",
    "@vueuse/core": "^14.4.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@zxcvbn-ts/core": "^4.2.0",
    "animate.css": "^4.1.1",
    "axios": "^1.20.0",
    "cropperjs": "^2.2.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "^2.1.0",
    "element-plus": "^2.14.5",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.16.0",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.10",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.3.1",
    "vue-types": "^7.0.0",
    "xgplayer": "^3.0.26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@unocss/transformer-variant-group": "^66.10.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "less": "^4.9.1",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "unocss": "^66.10.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
