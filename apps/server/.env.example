#  本地开发时使用,最终线上读取的变量是项目根目录的env文件
#
# compose.local.yml 从仓库根目录 .env 读取 POSTGRES_*（不是本文件）。
# 根 .env 与下面 PG_DATABASE_URL 的用户/密码/库名必须一致。

POSTGRES_USER=root
POSTGRES_PASSWORD=your-local-password
POSTGRES_DB=ad4353
PG_DATABASE_URL="postgresql://root:your-local-password@localhost:5432/ad4353"

PORT=3000
TOKEN_SECRET=xzz2021353345
TOKEN_REFRESH_SECRET=xzz20224353
TOKEN_EXPIRES_TIME=30000
TOKEN_REFRESH_EXPIRES_TIME=259200

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=xz4353z...
REDIS_URL=redis://localhost:6379

SSO_COUNT=3
SWAGGER=true
# 仅当 SWAGGER=true 时配置；密码至少 6 位且不得使用占位值
SWAGGER_USERNAME=adm4353in
SWAGGER_PASSWORD=123453456
STATIC_FILE_ROOT_PATH=public
STATIC_FILE_SERVE_ROOT=api/public


HELMET=true

# 本地文件日志（warn+，按小时滚动，单文件 2m，最多 10 个）。默认关闭
LOG_FILE=false

# 首次初始化数据库需要
SEED_ADMIN_USERNAME=xzz2021
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_PHONE=13011112222

# 跨域白名单，逗号分隔，Origin 不要带末尾 /。留空则关闭 Nest CORS（同源 Nginx 反代不需要）
# CORS_ORIGINS=http://localhost:4000
