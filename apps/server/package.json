{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "xzz2021",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#/*": {
      "types": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "dev": "nest start --watch",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" \"*.ts\"",
    "lint:eslint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test:ci": "jest --runInBand --ci",
    "prisma:init": "pnpm prisma migrate dev",
    "prisma:gen": "pnpm prisma generate",
    "prisma:seed": "pnpm prisma db seed",
    "prisma:val": "pnpm prisma validate"
  },
