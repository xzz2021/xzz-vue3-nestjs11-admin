// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Zod schema 生成器（字段校验通过 /// @zod.xxx 注释注入）
generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/zod"
  config   = "./zod-generator.config.json"
}

datasource db {
  provider = "postgresql"
}

enum NoticeLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum MenuType {
  DIRECTORY
  MENU
}

enum PermissionType {
  BUTTON
  DATA
  API
  FIELD
  OTHER
}

enum MessageType {
  MAIL
  SYSTEM
  ALERT
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
  EXPIRED
}

enum DataScope {
  ALL
  SELF
  DEPT
  DEPT_TREE

  //  自定义
  CUSTOM_DEFINE
}

enum CustomerStatus {
  LEAD
  FOLLOWING
  WON
  FROZEN
}

enum FileUploadStatus {
  INITIATED
  UPLOADING
  COMPLETING
  COMPLETED
  ABORTED
  EXPIRED
  FAILED
}

model User {
  id       String @id @default(cuid())
  /// @zod.min(2).max(50).meta({ description: '用户名', example: 'admin' })
  username String
  /// @zod.min(6).max(128).meta({ description: '密码（存储哈希值）', example: '123456' })
  password String
  /// @zod.max(50).meta({ description: '昵称', example: 'admin' })
  nickname String?
  /// @zod.email('邮箱格式不正确').meta({ description: '邮箱', example: 'admin@example.com' })
  email    String? @unique
  /// @zod.regex(/^1[3-9]\d{9}$/, '手机号格式不正确').meta({ description: '手机号', example: '13800138000' })
  phone    String  @unique
  /// @zod.url('头像地址格式不正确').meta({ description: '头像 URL', example: 'https://example.com/avatar.png' })
  avatar   String?
  /// @zod.meta({ description: '是否启用', example: true })
  enabled  Boolean @default(true)
  /// @zod.meta({ description: '最后登录时间', example: '2026-01-01T12:00:00.000Z' })
  lastLoginAt DateTime?
  /// @zod.max(45).meta({ description: '最后登录 IP', example: '127.0.0.1' })
  lastLoginIp String?
  /// @zod.max(100).meta({ description: '最后登录地理位置', example: '中国 广东省 深圳市' })
  lastLoginLocation String? @db.VarChar(100)
  /// @zod.max(500).meta({ description: '备注', example: '备注' })
  remark String?
  /// @zod.meta({ description: '密码修改时间', example: '2026-01-01T12:00:00.000Z' })
  passwordChangedAt DateTime?
  /// @zod.meta({ description: '部门 ID', example: 'clxxx' })
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
  operationLogs UserOperationLog[]
  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  backupJobs       DbBackupJob[]
  createdRoles     Role[]    @relation("RoleCreator")
  assignedUserRoles UserRole[] @relation("UserRoleAssigner")
  ownedCustomers   Customer[] @relation("CustomerOwner")
  createdCustomers Customer[] @relation("CustomerCreator")
  uploadSessions   FileUploadSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([createdAt(sort: Desc)])
}

model Role {
  id String @id @default(cuid())
  /// @zod.min(1).max(50).meta({ description: '角色编码，唯一标识', example: 'SUPER_ADMIN' })
  code        String  @unique
  /// @zod.min(1).max(50).meta({ description: '角色名称', example: '超级管理员' })
  name        String
  /// @zod.max(200).meta({ description: '角色描述', example: '拥有全部后台权限' })
  description String?
  /// @zod.min(0).meta({ description: '排序', example: 0 }).default(0)
  sort    Int     @default(0)
  /// @zod.meta({ description: '是否启用', example: true })
  enabled Boolean @default(true)
  /// @zod.meta({ description: '是否系统角色，系统角色不可删除', example: false }).default(false)
  isSystem Boolean @default(false)
  users       UserRole[]
  menus       RoleMenu[]
  permissions RolePermission[]
  /// @zod.meta({ description: '创建人用户 ID', example: 'clxxx' })
  createdById String?
  createdBy   User?   @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// @zod.meta({ description: '分配人用户 ID', example: 'clxxx' })
  assignedById String?
  assignedBy   User?   @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  /// @zod.meta({ description: '分配时间', example: '2026-01-01T12:00:00.000Z' })
  assignedAt DateTime?
  createdAt  DateTime @default(now())

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([assignedById])
}

model Menu {
  id       String   @id @default(cuid())
  parentId String?
  parent   Menu?    @relation("MenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Menu[]   @relation("MenuTree")
  type MenuType @default(DIRECTORY)
  /// @zod.min(1).max(50).meta({ description: '路由名称，全局唯一，用于前端 keep-alive', example: 'User' })
  name String @unique
  /// @zod.min(1).max(100).meta({ description: '路由路径，全局唯一', example: 'authorization/user' })
  path String @db.VarChar(100) @unique
  /// @zod.max(100).meta({ description: '前端组件路径', example: 'views/Authorization/User/User' })
  component String? @db.VarChar(100)
  /// @zod.max(100).meta({ description: '重定向路径', example: '/authorization/user' })
  redirect String? @db.VarChar(100)
  /// @zod.min(1).max(50).meta({ description: '菜单标题，用于 i18n 展示', example: '用户管理' })
  title String @db.VarChar(50)
  /// @zod.meta({ description: '是否启用', example: true })
  enabled Boolean @default(true)

  // 以下 meta 字段内嵌于 Menu，供前端路由渲染
  /// @zod.meta({ description: '是否缓存页面', example: false }).default(false)
  keepAlive  Boolean @default(false)
  /// @zod.min(0).meta({ description: '排序', example: 0 }).default(0)
  sort       Int     @default(0)
  /// @zod.max(50).meta({ description: '菜单图标', example: 'mdi:account' })
  icon       String? @db.VarChar(50)
  /// @zod.meta({ description: '是否固定标签页', example: false }).default(false)
  affix      Boolean @default(false)
  /// @zod.max(100).meta({ description: '高亮菜单路径（隐藏子路由时指向父级）', example: '/authorization/user' })
  activeMenu String? @db.VarChar(100)
  /// @zod.meta({ description: '是否始终显示根菜单', example: false }).default(false)
  alwaysShow Boolean @default(false)
  /// @zod.meta({ description: '是否显示面包屑', example: true })
  breadcrumb Boolean @default(true)
  /// @zod.meta({ description: '是否允许跳转', example: false }).default(false)
  canTo      Boolean @default(false)
  /// @zod.meta({ description: '是否在侧边栏隐藏', example: false }).default(false)
  hidden     Boolean @default(false)
  /// @zod.meta({ description: '是否禁用 keep-alive', example: false }).default(false)
  noCache    Boolean @default(false)
  /// @zod.meta({ description: '是否隐藏标签页', example: false }).default(false)
  noTagsView Boolean @default(false)
  /// @zod.meta({ description: '是否外部链接', example: false }).default(false)
  external Boolean @default(false)
  /// @zod.max(100).regex(/^(https?:\/\/.+|\/.*)$/, '外部链接格式不正确').meta({ description: '外部链接地址，支持 http(s) 绝对地址或 / 开头的相对地址', example: 'https://example.com' })
  link String? @db.VarChar(100)

  roles       RoleMenu[]
  permissions Permission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([sort])
  @@index([enabled])
}

model Permission {
  /// @zod.meta({ description: '所属菜单 ID', example: 'clxxx' })
  id   String @id @default(cuid())
  /// @zod.min(1).max(50).meta({ description: '权限名称', example: '用户列表' })
  name String
  /// @zod.min(1).max(100).meta({ description: '权限编码，唯一标识', example: 'system:user:list' })
  code String @unique
  resource String? @db.VarChar(100)
  action String? @db.VarChar(50)
  /// @zod.default(false)
  scopeEnabled Boolean @default(false)
  type PermissionType
  /// @zod.min(0).meta({ description: '排序', example: 0 }).default(0)
  sort Int @default(0)
  /// @zod.meta({ description: '是否启用', example: true })
  enabled Boolean @default(true)
  menuId String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  roles  RolePermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([menuId])
  @@index([resource, action])
}

model RoleMenu {
  roleId String
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuId String
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
}

// 角色权限记录dataScope 控制数据范围
model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  dataScope    DataScope?
  customDepartments RolePermissionDepartment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model RolePermissionDepartment {
  id               String         @id @default(cuid())
  rolePermissionId String
  rolePermission   RolePermission @relation(fields: [rolePermissionId], references: [id], onDelete: Cascade)
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([rolePermissionId, departmentId])
  @@index([rolePermissionId])
  @@index([departmentId])
}

model Department {
  id       String       @id @default(cuid())
  parentId String?
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  /// @zod.min(1).max(50).meta({ description: '部门名称', example: '研发部' })
  name String
  /// @zod.max(512).meta({ description: '物化路径，用于树形查询', example: 'ROOT/child' })
  path String @db.VarChar(512)
  /// @zod.min(0).meta({ description: '排序', example: 0 }).default(0)
  sort        Int     @default(0)
  /// @zod.meta({ description: '是否启用', example: true })
  enabled     Boolean @default(true)
  /// @zod.max(200).meta({ description: '部门描述', example: '负责产品研发' })
  description String?
  users                     User[]
  rolePermissionDepartments RolePermissionDepartment[]
  customers                 Customer[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  /// 迁移用 UNIQUE NULLS NOT DISTINCT 重建同名索引，使 parentId = NULL 的根部门 name 也唯一
  @@unique([parentId, name])
  @@index([parentId])
  @@index([path])
}

model Customer {
  id           String         @id @default(cuid())
  name         String         @db.VarChar(100)
  phone        String?        @db.VarChar(30)
  remark       String?        @db.Text
  status       CustomerStatus @default(LEAD)
  dealAmount   Decimal        @default(0) @db.Decimal(18, 2)
  internalCost Decimal        @default(0) @db.Decimal(18, 2)
  /// @zod.default(false)
  confidential Boolean        @default(false)
  ownerId      String
  owner        User           @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User           @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  /// @zod.default(0)
  version      Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ownerId])
  @@index([departmentId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([departmentId, status, createdAt(sort: Desc)])
  @@index([createdById])
}

model DictionaryType {
  id   String @id @default(cuid())
  /// @zod.min(1).max(50).meta({ description: '字典编码，唯一标识', example: 'user_status' })
  code String @unique
  /// @zod.min(1).max(50).meta({ description: '字典名称', example: '用户状态' })
  name    String
  /// @zod.meta({ description: '是否启用', example: true })
  enabled Boolean @default(true)
  items   DictionaryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DictionaryItem {
  id     String         @id @default(cuid())
  typeId String
  type   DictionaryType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  /// @zod.min(1).max(50).meta({ description: '字典项标签', example: '启用' })
  label String
  /// @zod.min(1).max(50).meta({ description: '字典项值', example: '1' })
  value String
  /// @zod.min(0).meta({ description: '排序', example: 0 }).default(0)
  sort    Int     @default(0)
  /// @zod.meta({ description: '是否启用', example: true })
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([typeId, value])
  @@index([typeId, sort])
}

model Notice {
  id      String      @id @default(cuid())
  /// @zod.min(1).max(100).meta({ description: '公告标题', example: '系统维护通知' })
  title   String
  /// @zod.min(1).meta({ description: '公告内容', example: '系统将于今晚 22:00 维护' })
  content String      @db.Text
  level     NoticeLevel @default(INFO)
  /// @zod.meta({ description: '是否已发布', example: false }).default(false)
  published Boolean     @default(false)
  /// @zod.meta({ description: '生效开始时间', example: '2026-01-01T00:00:00.000Z' })
  startsAt DateTime?
  /// @zod.meta({ description: '生效结束时间', example: '2026-12-31T23:59:59.000Z' })
  endsAt   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, startsAt, endsAt])
}

/// 站内消息：站内信 / 系统通知 / 告警（每条对应一个接收人）
model Message {
  id    String      @id @default(cuid())
  /// 派发批次 ID（Bull 任务幂等，防重试重复落库）
  dispatchId String
  type  MessageType
  /// @zod.min(1).max(200).meta({ description: '消息标题', example: '系统通知' })
  title String      @db.VarChar(200)
  /// @zod.min(1).meta({ description: '消息内容', example: '服务已恢复' })
  content String @db.Text
  level NoticeLevel @default(INFO)
  /// @zod.meta({ description: '发送人 ID，系统/告警可为空', example: 'clxxx' })
  senderId String?
  sender   User?   @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  /// @zod.meta({ description: '接收人 ID', example: 'clxxx' })
  receiverId String
  receiver   User   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  /// @zod.meta({ description: '已读时间', example: '2026-01-01T12:00:00.000Z' })
  readAt DateTime?
  /// 扩展信息：链接、来源模块等
  meta Json?
  createdAt DateTime @default(now())

  @@unique([dispatchId, receiverId])
  @@index([receiverId, createdAt(sort: Desc)])
  @@index([receiverId, readAt])
  @@index([type, createdAt])
}

model UserSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @zod.min(1).meta({ description: 'Token 哈希值', example: 'sha256..' })
  tokenHash String   @unique
  /// @zod.max(45).meta({ description: '登录 IP', example: '127.0.0.1' })
  ip        String?
  /// @zod.max(100).meta({ description: '登录地理位置', example: '中国 广东省 深圳市' })
  location  String? @db.VarChar(100)
  /// @zod.max(500).meta({ description: 'User-Agent', example: 'Mozilla/5.0' })
  userAgent String?
  /// @zod.meta({ description: '过期时间', example: '2026-01-02T12:00:00.000Z' })
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// @zod.min(1).max(80).meta({ description: '领域动作', example: 'user.update' })
  action String @db.VarChar(80)
  /// @zod.min(1).max(100).meta({ description: '聚合根类型', example: 'User' })
  resource String @db.VarChar(100)
  /// @zod.max(64).meta({ description: '聚合根 ID', example: 'clxxx' })
  resourceId String? @db.VarChar(64)
  /// @zod.meta({ description: '业务是否成功', example: true })
  success Boolean @default(true)
  /// @zod.max(45).meta({ description: '操作 IP', example: '127.0.0.1' })
  ip String? @db.VarChar(45)
  /// @zod.max(100).meta({ description: '操作地理位置', example: '中国 广东省 深圳市' })
  location String? @db.VarChar(100)
  metadata Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, createdAt])
  @@index([action, createdAt])
  @@index([resourceId, createdAt])
}

model DbBackupConfig {
  /// @zod.meta({ description: '配置主键', example: 'default' })
  id String @id @default("default")
  /// @zod.meta({ description: '是否启用定时备份', example: true })
  enabled Boolean @default(true)
  /// @zod.min(9).max(100).meta({ description: 'Cron 表达式', example: '0 0 * * * *' })
  cron String @db.VarChar(100)
  /// @zod.min(1).max(50).meta({ description: '时区', example: 'Asia/Shanghai' })
  timezone String @db.VarChar(50)
  /// @zod.min(1).max(999).meta({ description: '最大保留数量', example: 24 })
  retentionMax Int @default(24)
  /// @zod.min(1).max(80).meta({ description: '备份文件名前缀', example: 'backstage_db' })
  filePrefix String @db.VarChar(80)
  /// @zod.meta({ description: '是否启用 gzip 压缩', example: true })
  gzip Boolean @default(true)
  /// @zod.meta({ description: '最近一次执行时间', example: '2026-01-01T12:00:00.000Z' })
  lastRunAt DateTime?
  lastStatus BackupStatus?
  /// @zod.max(1000).meta({ description: '最近一次错误信息', example: 'pg_dump exited with code 1' })
  lastError String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DbBackupJob {
  id String @id @default(cuid())
  trigger BackupTrigger
  status BackupStatus
  /// @zod.min(1).max(255).meta({ description: '备份文件名', example: 'backstage_db_20260101_120000.sql.gz' })
  fileName String @db.VarChar(255)
  /// @zod.min(1).max(500).meta({ description: '备份文件路径', example: '/app/apps/server/backups/backstage_db_20260101_120000.sql.gz' })
  filePath String @db.VarChar(500)
  /// @zod.meta({ description: '备份文件大小（字节）', example: '1024' })
  fileSize BigInt?
  /// @zod.length(64).meta({ description: '文件 SHA-256 校验值', example: '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' })
  checksum String? @db.VarChar(64)
  /// @zod.meta({ description: '开始执行时间', example: '2026-01-01T12:00:00.000Z' })
  startedAt DateTime @default(now())
  /// @zod.meta({ description: '执行完成时间', example: '2026-01-01T12:01:00.000Z' })
  finishedAt DateTime?
  /// @zod.min(0).meta({ description: '执行耗时（毫秒）', example: 1200 })
  durationMs Int?
  /// @zod.max(2000).meta({ description: '错误信息', example: 'spawn pg_dump ENOENT' })
  errorMessage String? @db.VarChar(2000)
  /// @zod.meta({ description: '手动触发人用户 ID', example: 'clxxx' })
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([createdById])
}

model File {
  id   Int    @id @default(autoincrement())
  /// @zod.min(1).max(255).meta({ description: '文件名', example: 'avatar.png' })
  name      String  @db.VarChar(255)
  /// @zod.min(1).max(255).meta({ description: 'MIME 类型', example: 'image/png' })
  mimeType  String  @db.VarChar(255)
  /// @zod.min(1).max(255).meta({ description: '存储路径', example: '/uploads/2026/avatar.png' })
  path      String  @unique @db.VarChar(255)
  /// @zod.max(20).meta({ description: '文件扩展名', example: 'png' })
  extension String? @db.VarChar(20)
  /// @zod.coerce().meta({ description: '文件大小（字节）', example: '1024' })
  size BigInt
  /// @zod.url('文件 URL 格式不正确').max(255).meta({ description: '访问 URL', example: 'https://example.com/uploads/avatar.png' })
  url  String @db.VarChar(255)
  /// @zod.length(64).regex(/^[0-9a-f]{64}$/).meta({ description: 'SHA-256', example: '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' })
  sha256 String? @db.Char(64)
  createdAt DateTime @default(now())
  /// @zod.meta({ description: '软删除时间，待异步清理磁盘', example: '2026-01-01T12:00:00.000Z' })
  deletedAt DateTime?

  @@index([extension])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([sha256])
}

model FileUploadSession {
  id           String           @id @default(cuid())
  /// @zod.length(64).regex(/^[0-9a-f]{64}$/).meta({ description: '申报 SHA-256', example: '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef' })
  sha256       String           @db.Char(64)
  /// @zod.coerce().meta({ description: '文件大小（字节）', example: '1024' })
  size         BigInt
  /// @zod.min(1).max(255).meta({ description: '原始文件名', example: 'report.docx' })
  originalName String           @db.VarChar(255)
  /// @zod.min(1).max(255).meta({ description: 'MIME 类型', example: 'application/pdf' })
  mimeType     String           @db.VarChar(255)
  /// @zod.coerce().int().positive().meta({ description: '分片大小', example: 5242880 })
  chunkSize    Int
  /// @zod.coerce().int().positive().meta({ description: '分片总数', example: 12 })
  totalChunks  Int
  status       FileUploadStatus @default(INITIATED)
  createdById  String
  createdBy    User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  /// @zod.min(1).max(255).meta({ description: '临时目录相对路径', example: 'file/tmp/clxxx' })
  tempDir      String           @db.VarChar(255)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  chunks       FileUploadChunk[]

  @@index([createdById])
  @@index([sha256])
  @@index([status, expiresAt])
}

model FileUploadChunk {
  id         Int               @id @default(autoincrement())
  sessionId  String
  session    FileUploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  chunkIndex Int
  size       Int

  @@unique([sessionId, chunkIndex])
  @@index([sessionId])
}

model UserOperationLog {
  id Int @id @default(autoincrement())
  /// @zod.max(45).meta({ description: '请求 IP', example: '127.0.0.1' })
  ip         String  @db.VarChar(50)
  /// @zod.max(100).meta({ description: '请求地理位置', example: '中国 广东省 深圳市' })
  location   String? @db.VarChar(100)
  /// @zod.max(500).meta({ description: 'User-Agent', example: 'Mozilla/5.0' })
  userAgent  String  @db.VarChar(500)
  /// @zod.max(10).meta({ description: 'HTTP 方法', example: 'GET' })
  method     String  @db.VarChar(10)
  /// @zod.max(255).meta({ description: '请求 URL', example: '/api/users' })
  requestUrl String  @db.VarChar(255)
  /// @zod.meta({ description: '是否成功', example: true })
  isSuccess     Boolean     @default(true)
  /// @zod.max(500).meta({ description: '响应消息', example: 'OK' })
  responseMsg String? @db.VarChar(500)
  detailInfo  Json?
  /// @zod.coerce().int().min(0).meta({ description: '请求耗时（毫秒）', example: 120 })
  duration    Int
  /// @zod.meta({ description: '操作用户 ID', example: 'clxxx' })
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
